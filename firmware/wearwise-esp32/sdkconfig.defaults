# WearWise ESP32 firmware — build-time defaults. `idf.py build` merges these into
# sdkconfig on first configure; sdkconfig itself is generated and not committed.

# ---- Bluetooth: NimBLE host, BLE-only controller (no Classic) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# Peripheral only: the phone is the central. Dropping the other roles trims RAM.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# One full 200-sample protocol packet is 462 bytes; with the 3-byte ATT header it
# needs the 517-byte MTU both platforms can negotiate (sensor-protocol/types.ts).
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517

CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="WearWise"
CONFIG_BT_NIMBLE_LOG_LEVEL_INFO=y

# Pairing: LE Secure Connections + passkey (MITM), bonds kept in NVS so a paired
# phone reconnects without pairing again (communication/ble_pairing.c).
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# SC-only: refuse legacy pairing and encryption keys shorter than 128 bits. (An int
# in ESP-IDF 5.4's NimBLE Kconfig, not a bool.) gatt.c also sets ble_hs_cfg.sm_sc_only
# at run time, so an older local sdkconfig without this line is still SC-only.
CONFIG_BT_NIMBLE_SM_SC_ONLY=1

# ---- Flash / partitions (ESP-WROOM-32, 4 MB) ----
# partitions.csv = single-app-large + the `wwcfg` factory sector (label PIN).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Wi-Fi station + HTTP/WebSocket server ----
# Coexistence: BLE (NimBLE) and Wi-Fi run together so the phone can provision over
# BLE and stream over Wi-Fi, and fall back to BLE without dropping the session.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_HTTPD_WS_SUPPORT=y
# The Wi-Fi stream is TLS-only (wss://, port 443) with a per-patch self-signed
# certificate that the phone pins over BLE. Dynamic buffers keep the TLS session's
# RAM small next to the BLE + Wi-Fi stacks.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# The certificate is P-256, so the server can only ever negotiate (EC)DH-ECDSA
# suites. Static key exchanges (no forward secrecy) are compiled out, which leaves
# ECDHE-ECDSA only; the phone uses ECDHE-ECDSA-AES-GCM. ECDHE-RSA stays available
# for a future TLS *client* (e.g. OTA) — mbedTLS config is global. Narrowing further
# to the AEAD suites needs a ciphersuite list, which esp_https_server 5.4 does not
# expose (README: Production hardening).
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_RSA=n

# ---- Diagnostics ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
