{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "description": "WearWise viewer dashboard: authorised researchers and clinicians read the data participants chose to share with them.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy-config": "node scripts/deploy-headers.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --root ../../packages/legal",
    "test:watch": "vitest",
    "firmware:export": "node ../../firmware/wearwise-esp32/tools/export-firmware.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@wearwise/design-tokens": "*",
    "@wearwise/legal": "*",
    "@wearwise/password": "*",
    "@wearwise/sensor-protocol": "*",
    "esptool-js": "0.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "^7.18.5",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/spark-md5": "^3.0.5",
    "@types/w3c-web-serial": "^1.0.9",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
